# ═══════════════════════════════════════════════════════════
# LiverCare AI - Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# RAG Pipeline (existing)
EMBEDDING_PROVIDER=local
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Medical AI Chat (HuggingFace)
HF_TOKEN=your_huggingface_token_here
HF_MEDICAL_MODEL=Qwen/Qwen2.5-7B-Instruct

# Lab Analyzer (Google AI Studio)
GOOGLE_API_KEY=your_google_api_key_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=604800

# SMTP (for OTP emails - optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@livercare.internal
